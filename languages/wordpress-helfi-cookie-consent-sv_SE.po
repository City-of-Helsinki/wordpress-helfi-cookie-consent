msgid "Accept required cookies"
msgstr "Acceptera obligatoriska cookies"

#: features/placeholders/content/class-iframe-placeholder.php:74
msgctxt "placeholder notice button"
msgid "See content on external site"
msgstr "Se innehåll på extern webbplats"

#: features/placeholders/content/class-script-placeholder.php:46
#, php-format
msgctxt "placeholder notice text"
msgid "Enabling the usage of %1$s cookies will allow you to share your input."
msgstr ""
"Om du aktiverar användningen av %1$s cookies kan du dela dina synpunkter."

#: features/placeholders/content/class-iframe-placeholder.php:51
#, php-format
msgctxt "placeholder notice text"
msgid ""
"This content is hosted by %1$s. To see the content, switch over to the "
"external site or accept the usage of %2$s cookies."
msgstr ""
"Det här innehållet hämtas från %1$s. För att visa innehållet krävs att du "
"godkänner webbplatsens cookies. Du kan se innehållet antingen genom att gå "
"till en extern webbplats eller genom att ge ditt samtycke till användningen "
"av cookies för %2$s."

#: features/placeholders/content/class-iframe-placeholder.php:34
msgctxt "placeholder notice title"
msgid "Content cannot be displayed"
msgstr "Innehållet kan inte visas"

#: features/placeholders/content/class-script-placeholder.php:34
