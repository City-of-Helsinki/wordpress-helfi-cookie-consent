#: features/models/categories/class-statistics-anonymous-cookie-category.php:44
msgid "Statistics (anonymous)"
msgstr "Tilastointi (anonyymi)"

#: features/notices/class-missing-cookie-provider-notice.php:51
msgid "Supported cookie providers"
msgstr "Tuetut evästetarjoajat"

#: features/notices/class-missing-cookie-provider-notice.php:39
msgid ""
"The cookie banner won't be able to group and list the cookies used on this "
"site without a cookie provider."
msgstr ""
"Evästebanneri ei voi ryhmitellä ja listata sivustolla käytettyjä evästeitä "
"ilman evästetarjoajaa."

#: features/notices/class-missing-cookie-provider-notice.php:38
msgid "The cookie consent is missing a cookie provider."
msgstr "Evästehallinnalta puuttuu evästeiden tarjoaja."

#: features/models/categories/class-statistics-anonymous-cookie-category.php:50
#: features/models/categories/class-statistics-cookie-category.php:50
msgid ""
"The information collected by statistics cookies is used for developing the "
"website."
msgstr ""
"Tilastointievästeiden keräämää tietoa käytetään verkkosivuston kehittämiseen."

